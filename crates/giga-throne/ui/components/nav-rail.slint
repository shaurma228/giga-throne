import { Theme } from "../theme.slint";

// Left navigation column: logo and section switcher. `active` is the page index.
export component NavRail inherits Rectangle {
    width: 72px;
    background: Theme.panel;

    in property <int> active: 0;

    // A click asks for the page; the window decides (the editor may hold unsaved changes).
    callback navigate(int);

    VerticalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;
            padding-bottom: 8px;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-s;
                background: Theme.accent;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "gt";
                    color: Theme.on-accent;
                    font-family: Theme.font-display;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Icons from the design (docs/design/Routes.dc.html), drawn in a 24px box.
        for item[i] in [
            { label: "Главная", icon: "M 3 11 L 12 4 L 21 11 M 5 10 L 5 20 L 19 20 L 19 10", enabled: true },
            { label: "Маршруты", icon: "M 6 3 L 6 21 M 6 9 A 6 6 0 0 0 12 15 L 18 15 M 15 12 L 18 15 L 15 18", enabled: true },
            { label: "Статистика", icon: "M 5 20 L 5 11 M 12 20 L 12 4 M 19 20 L 19 14", enabled: false },
        ] : HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: Theme.radius-s;
                background: root.active == i && item.enabled ? Theme.raised : transparent;
                accessible-role: button;
                accessible-label: item.label;
                accessible-enabled: item.enabled;

                Path {
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: item.icon;
                    stroke: !item.enabled ? Theme.line : root.active == i ? Theme.accent : Theme.muted;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }

                TouchArea {
                    enabled: item.enabled;
                    mouse-cursor: item.enabled ? pointer : default;
                    clicked => {
                        root.navigate(i);
                    }
                }
            }
        }
    }
}
