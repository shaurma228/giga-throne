import { Theme } from "theme.slint";
// Fonts are embedded at build time; family names come from the files' name tables (see Theme.font-*).
// Variable TTFs: Slint applies the requested weight through the wght axis. OFL texts: fonts/*-OFL.txt.
import "fonts/Unbounded-Variable.ttf";
import "fonts/Manrope-Variable.ttf";
import "fonts/JetBrainsMono-Variable.ttf";
import { NavRail } from "components/nav-rail.slint";
import { ServerList, ServerItem } from "components/server-list.slint";
import { HomeScreen } from "screens/home.slint";
import { RoutesScreen, PresetItem, RouteItem } from "screens/routes.slint";
import {
    RouteEditorScreen, EditorState, BucketItem, ChipItem, ReadyListItem, RuleItem, CondItem,
    ValueItem, CondChoice, ActionChoice,
} from "screens/route-editor.slint";

export {
    Theme, ServerItem, PresetItem, RouteItem, EditorState, BucketItem, ChipItem, ReadyListItem,
    RuleItem, CondItem, ValueItem, CondChoice, ActionChoice,
}

export component AppWindow inherits Window {
    title: "giga-throne";
    preferred-width: 1040px;
    preferred-height: 680px;
    min-width: 1040px;
    min-height: 680px;
    background: Theme.bg;
    default-font-family: Theme.font-body;
    no-frame: false;

    in property <string> engine-status: "Движок запускается…";

    // Page shown: 0 Home (with the server list), 1 Routes, 2 the route editor (opened from Routes).
    in-out property <int> page: 0;

    // Home screen state, set from Rust (src/view.rs).
    in-out property <string> conn-state: "off";
    in-out property <string> status-text: "Не защищено";
    in-out property <string> timer: "00:00:00";
    in-out property <string> hint;
    in-out property <string> server-name: "Нет серверов";
    in-out property <string> server-code: "··";
    in-out property <string> server-proto;
    in-out property <string> server-ping: "—";
    in-out property <string> down-rate: "—";
    in-out property <string> up-rate: "—";
    in-out property <string> inbound-text: "—";
    in-out property <string> error-text;

    // Server list state, set from Rust.
    in-out property <[ServerItem]> servers;
    in-out property <string> import-text;
    in-out property <string> import-result;

    // "Системный прокси" switch, set from Rust (src/view.rs).
    in-out property <bool> sysproxy-on: true;

    // Routes screen state, set from Rust (src/view.rs).
    in-out property <string> route-region: "ru";
    in-out property <[PresetItem]> route-presets;
    in-out property <[RouteItem]> route-rows;
    in-out property <string> busy-preset;
    in-out property <int> busy-route: -1;
    in-out property <bool> busy-import;
    in-out property <string> route-note;
    in-out property <bool> route-note-bad;

    callback toggle();
    callback pick(int);
    callback import-link(string);
    callback toggle-sysproxy();
    callback select-preset(string);
    callback activate-route(int);
    callback import-route(string);
    callback delete-route(int);
    callback set-region(string);
    callback create-route();
    callback edit-route(int);

    // Every page change goes through here: the editor asks before it is left unsaved.
    function navigate(to: int) {
        if root.page == 2 && to != 2 {
            EditorState.flush();
            if EditorState.dirty {
                EditorState.leave-pending = to;
                return;
            }
        }
        root.page = to;
    }

    HorizontalLayout {
        NavRail {
            active: root.page == 2 ? 1 : root.page;
            navigate(to) => {
                root.navigate(to);
            }
        }

        if root.page == 0 : HomeScreen {
            horizontal-stretch: 1;
            engine-status: root.engine-status;
            conn-state <=> root.conn-state;
            status-text <=> root.status-text;
            timer <=> root.timer;
            hint <=> root.hint;
            server-name <=> root.server-name;
            server-code <=> root.server-code;
            server-proto <=> root.server-proto;
            server-ping <=> root.server-ping;
            down-rate <=> root.down-rate;
            up-rate <=> root.up-rate;
            inbound-text <=> root.inbound-text;
            error-text <=> root.error-text;
            sysproxy-on <=> root.sysproxy-on;
            toggle => {
                root.toggle();
            }
            toggle-sysproxy => {
                root.toggle-sysproxy();
            }
        }

        if root.page == 0 : ServerList {
            servers <=> root.servers;
            import-text <=> root.import-text;
            import-result <=> root.import-result;
            import-link(text) => {
                root.import-link(text);
            }
            pick(id) => {
                root.pick(id);
            }
        }

        if root.page == 1 : RoutesScreen {
            horizontal-stretch: 1;
            region: root.route-region;
            presets: root.route-presets;
            rows: root.route-rows;
            busy-preset: root.busy-preset;
            busy-route: root.busy-route;
            busy-import: root.busy-import;
            note: root.route-note;
            note-bad: root.route-note-bad;
            select-preset(id) => {
                root.select-preset(id);
            }
            activate-route(id) => {
                root.activate-route(id);
            }
            import-route(text) => {
                root.import-route(text);
            }
            delete-route(id) => {
                root.delete-route(id);
            }
            set-region(id) => {
                root.set-region(id);
            }
            create-route() => {
                root.create-route();
            }
            edit-route(id) => {
                root.edit-route(id);
            }
        }

        if root.page == 2 : RouteEditorScreen {
            horizontal-stretch: 1;
            navigate(to) => {
                root.navigate(to);
            }
            leave-confirmed(to) => {
                EditorState.leave-pending = -1;
                root.page = to;
            }
        }
    }
}
